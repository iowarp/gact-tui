<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist. CFBundleLocalizations lists the interface
  languages (web/src/i18n/locales.ts; a test keeps the two in step) so AppKit
  translates the menu items it adds itself (Close All, AutoFill, Emoji & Symbols,
  Window > Fill). Without it AppKit always runs in English.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
    <string>ja</string>
    <string>el</string>
  </array>
</dict>
</plist>
