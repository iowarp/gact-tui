{
  "name": "@clio/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./v3": "./src/v3/index.ts",
    "./types": "./src/wire/types.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/live-clio.test.ts",
    "test:live": "vitest run tests/live-clio.test.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "eslint": "9.16.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
