strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false
node-linker=isolated
public-hoist-pattern[]=pdfjs-dist
# Keep virtual-store directory names short. pnpm 9 names them up to 120
# characters (@base-ui+react@1.7.0_@date-fns+tz@..._react@19.2.8 is 118), and
# Node on Windows cannot read a package.json whose path reaches MAX_PATH (260):
# it silently treats the package as having no "imports" map, so base-ui's
# "#prehydration/*" specifiers fail with ERR_PACKAGE_IMPORT_NOT_DEFINED and every
# vitest suite that reaches a base-ui component fails to load from a checkout
# nested more than ~70 characters deep. 60 is pnpm 10's Windows default.
virtual-store-dir-max-length=60
