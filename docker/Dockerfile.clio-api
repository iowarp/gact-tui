# =============================================================================
# clio-api — standalone CLIO GACT REST API container
#
# Runs `clio-agent-gact` (clio-agent's GACT-conformant server) on :7777.
# This is the headless backend that the web app, the TUI, or any GACT client
# connects to.
#
# Build:
#   docker build -f docker/Dockerfile.clio-api -t clio-api .
#   # pin a clio-agent ref:
#   docker build -f docker/Dockerfile.clio-api --build-arg CLIO_REF=develop -t clio-api .
#
# Run:
#   docker run -d -p 7777:7777 --name clio-api clio-api
#   curl http://127.0.0.1:7777/v1/capabilities
#
# Provider wiring (no provider => capability-only mode; chat 503s):
#   docker run -d -p 7777:7777 \
#     -e CLIO_LM_PROVIDER=openai \
#     -e CLIO_LM_MODEL=gpt-4o-mini \
#     -e CLIO_LM_API_KEY=sk-... \
#     clio-api
# =============================================================================

# --- builder: install clio-agent (needs git for the VCS pip install) --------
FROM python:3.12-slim AS builder

# Overridable clio-agent git ref. develop is the GACT-server branch.
ARG CLIO_REF=develop

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# git is only needed to clone clio-agent during the pip install; it stays in
# the builder stage and never lands in the runtime image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# clio-agent's marketplace submodule may be declared with a GitHub SSH URL.
# CI/container builds do not carry an SSH agent, so rewrite those public GitHub
# submodule URLs to HTTPS before the VCS pip install initializes submodules.
RUN git config --global url."https://github.com/".insteadOf "git@github.com:"

# Self-contained venv so we can copy it wholesale into the slim runtime stage.
RUN python -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip uv

# Install clio-agent from its own uv.lock so git-sourced dependencies that are
# not published to an index (the pinned clio-schemas) resolve exactly as
# clio-agent's CI installs them. A plain VCS pip install reads only the index
# requirement and cannot see clio-agent's [tool.uv.sources] pins.
RUN git clone https://github.com/iowarp/clio-agent.git /build/clio-agent \
    && git -C /build/clio-agent checkout "${CLIO_REF}" \
    && git -C /build/clio-agent submodule update --init --recursive --depth 1 \
    && cd /build/clio-agent \
    && UV_PROJECT_ENVIRONMENT="$VIRTUAL_ENV" uv sync --frozen --no-dev --no-editable \
    && rm -rf /build/clio-agent

# --- runtime: slim image with just the venv ---------------------------------
FROM python:3.12-slim AS runtime

ARG CLIO_REF=develop
LABEL org.opencontainers.image.title="clio-api" \
      org.opencontainers.image.description="CLIO GACT REST API server (clio-agent-gact)" \
      org.opencontainers.image.source="https://github.com/iowarp/gact-tui" \
      org.opencontainers.image.licenses="MIT" \
      ai.iowarp.clio.ref="${CLIO_REF}"

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    # Bind to all interfaces so the published port is reachable from the host.
    CLIO_GACT_HOST=0.0.0.0 \
    CLIO_GACT_PORT=7777

# curl is used by the HEALTHCHECK and is handy for debugging inside the image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

# Non-root runtime user. clio writes session/artifact state under $HOME.
RUN useradd --create-home --uid 10001 clio
USER clio
WORKDIR /home/clio
ENV HOME=/home/clio

EXPOSE 7777

# /v1/capabilities is the contract probe endpoint — 200 once the server is up.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${CLIO_GACT_PORT}/v1/capabilities" >/dev/null || exit 1

# Host/port are env-driven so `docker run -e CLIO_GACT_PORT=...` just works.
ENTRYPOINT ["sh", "-c", "exec clio-agent-gact --host \"${CLIO_GACT_HOST}\" --port \"${CLIO_GACT_PORT}\""]
