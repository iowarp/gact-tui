# =============================================================================
# clio-web — CLIO agent + web UI in ONE container
#
# A single container that runs:
#   - clio-agent-gact on 127.0.0.1:7777 (loopback only — never exposed)
#   - nginx on :80 serving the built @clio/web static bundle, reverse-proxying
#     /v1/* to the local clio process so the browser sees a same-origin backend
#     (no CORS, and SSE streams cleanly through the proxy).
#
# Build context is the repository root. The React workspace, shared core, and
# product-neutral branding live at the top level.
#
# Build:
#   docker build -f docker/Dockerfile.clio-web -t clio-web .
#   docker build -f docker/Dockerfile.clio-web --build-arg CLIO_REF=develop -t clio-web .
#
# Run (browse http://localhost:17800):
#   docker run -d -p 17800:80 --name clio-web clio-web
#   # The web app's pure-web splash auto-probes http://localhost:17800 — so
#   # mapping the host port to 17800 makes it connect with zero clicks.
#
# Provider wiring (without one, chat 503s with agent:unavailable — expected):
#   docker run -d -p 17800:80 \
#     -e CLIO_LM_PROVIDER=openai -e CLIO_LM_MODEL=gpt-4o-mini \
#     -e CLIO_LM_API_KEY=sk-... clio-web
# =============================================================================

# --- stage 1: build the web bundle (Node + pnpm) ----------------------------
FROM node:22-bookworm-slim AS web-builder

ARG CLIO_REF=develop
ARG PNPM_VERSION=9.15.9
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /build

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/ ./packages/
COPY web/ ./web/
COPY branding/ ./branding/
COPY brand.config.json ./brand.config.json

# CLIO owns its product copy and assets. Resolve that profile from the agent
# repository at the paired ref rather than copying CLIO identity into GACT.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${CLIO_REF}" https://github.com/iowarp/clio-agent.git /clio-agent-brand \
    && printf '%s\n' '{"profile":"clio","brandingRoot":"/clio-agent-brand/branding"}' > brand.config.local.json

RUN pnpm install --frozen-lockfile --filter "@clio/workspace..."
RUN pnpm --filter @clio/workspace build \
    && test -f web/dist/index.html

# --- stage 2: install clio-agent (needs git for the VCS pip install) --------
FROM python:3.12-slim AS clio-builder

ARG CLIO_REF=develop
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# clio-agent's marketplace submodule may be declared with a GitHub SSH URL.
# CI/container builds do not carry an SSH agent, so rewrite those public GitHub
# submodule URLs to HTTPS before the VCS pip install initializes submodules.
RUN git config --global url."https://github.com/".insteadOf "git@github.com:"

RUN python -m venv "$VIRTUAL_ENV" \
    && pip install --upgrade pip uv

# Install clio-agent from its own uv.lock so git-sourced dependencies that are
# not published to an index (the pinned clio-schemas) resolve exactly as
# clio-agent's CI installs them. A plain VCS pip install reads only the index
# requirement and cannot see clio-agent's [tool.uv.sources] pins.
RUN git clone https://github.com/iowarp/clio-agent.git /build/clio-agent \
    && git -C /build/clio-agent checkout "${CLIO_REF}" \
    && git -C /build/clio-agent submodule update --init --recursive --depth 1 \
    && cd /build/clio-agent \
    && UV_PROJECT_ENVIRONMENT="$VIRTUAL_ENV" uv sync --frozen --no-dev --no-editable \
    && rm -rf /build/clio-agent

# --- stage 3: runtime (python + nginx, no build tools) ----------------------
FROM python:3.12-slim AS runtime

ARG CLIO_REF=develop
LABEL org.opencontainers.image.title="clio-web" \
      org.opencontainers.image.description="CLIO agent + web UI in one container (nginx + clio-agent-gact)" \
      org.opencontainers.image.source="https://github.com/iowarp/gact-tui" \
      org.opencontainers.image.licenses="MIT" \
      ai.iowarp.clio.ref="${CLIO_REF}"

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    # clio binds to loopback only — the browser reaches it through nginx /v1.
    CLIO_GACT_HOST=127.0.0.1 \
    CLIO_GACT_PORT=7777 \
    HOME=/home/clio

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 clio

# Python venv (clio-agent) and the built static web bundle.
COPY --from=clio-builder /opt/venv /opt/venv
COPY --from=web-builder /build/web/dist /usr/share/nginx/html

# nginx site config + the supervising entrypoint.
COPY docker/nginx-clio-web.conf /etc/nginx/conf.d/default.conf
COPY docker/clio-web-entrypoint.sh /usr/local/bin/clio-web-entrypoint.sh
RUN rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true \
    && chmod +x /usr/local/bin/clio-web-entrypoint.sh \
    # Let the clio user own the dirs nginx and clio write to so we can drop
    # root for the clio process while nginx (master) starts as root to bind :80.
    && mkdir -p /home/clio /var/log/clio \
    && chown -R clio:clio /home/clio /var/log/clio

EXPOSE 80

# Probe the web index through nginx; if nginx is up the proxy is reachable too.
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:80/" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/clio-web-entrypoint.sh"]
