data: {"type": "semantic.event", "occurred_at": "2026-06-26T06:43:56.547823+00:00", "payload": {"schema_version": "clio.semantic_event.v1", "event_id": "sem_93851317d8584eca", "event_type": "blueprint.delegation.completed", "session_id": "sess_57ac84d71ca3", "workspace_id": "ws_22a00fecef95", "trace_id": "trace_msg_user_b0b5df728a09", "turn_id": "msg_user_b0b5df728a09", "span_id": "sem_93851317d8584eca", "parent_span_id": "", "status": "completed", "summary": "gnss_timeseries_analysis returned a compact result to analysis.", "live_observed": true, "detail_level": "semantic", "occurred_at": "2026-06-26T06:43:56.538474+00:00", "actor": {"agent_id": "gnss_timeseries_analysis", "role": "child_expert"}, "subject": {"agent_id": "analysis", "role": "parent_expert"}, "blueprint": {"pack_id": "earthscope-gnss-region", "pack_version": "0.1.0", "agent_blueprint_id": "earthscope-gnss-region", "parent_expert": "analysis", "child_expert": "gnss_timeseries_analysis"}, "provider": {"provider_id": "", "model_id": ""}, "payload": {"delegate_to": "gnss_timeseries_analysis", "agent_id": "gnss_timeseries_analysis", "question": "Profile the staged MTA1 GNSS time-series CSV at `/tmp/claude-1000/-home-jcernuda/bb1bd9e8-d4b5-42a4-b525-af9e6ee77aaa/scratchpad/la_run/ws/MTA1.CI.LY_.30.csv`. Report all column names, data types, total row count, value ranges for displacement components (east, north, up if present), time/epoch column details, temporal span, sampling interval/cadence, and any uncertainty/quality columns. Provide scan-limited profile evidence (rows examined, rows profiled for statistics).", "status": "completed", "execute": true, "source": "agent_next_expert", "parent_id": "analysis", "pack_id": "earthscope-gnss-region", "pack_version": "0.1.0", "provider_id": "", "model_id": "", "fallback_warnings": [], "stage": "delegate.completed", "delegation_lifecycle": "sync", "return_to": "analysis", "depth": 0, "duration_ms": 46071, "execution_mode": "blueprint_react", "input": "Profile th