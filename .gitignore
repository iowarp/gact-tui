# Local research clones — read-only references, not part of the project
research/

# iowarp/clio-agent clone — exploration only, integration target for
# the TUI. Not part of this repo's distribution; kept out of tracking.
clio-agent/

# Go build artifacts
bin/
.tools/
*.test
*.out
*.prof
coverage.txt
coverage.html

# Loop-test artifacts (kept for reference but binaries/screenshots regenerated)
loop-test/hello
loop-test/hello.gif
loop-test/screenshot.png
loop-test/loop-test
# Note: loop-test/testdata/ holds the committed teatest golden fixtures
# (required for `go test` to pass in CI) — do NOT ignore it.

# Claude Code session-only state
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/settings.local.json
.clio-agent-artifacts/
.playwright-mcp/
.mcp.json
tmp/
tui/gact.exe

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Env / secrets
.env
.env.*
*.pem
*.key

# Emulator / TUI build outputs (added once those exist)
emulator/emulator-server
# Stray binary that occasionally lands at the repo root from
# `go build -o emulator-server ./emulator/...` run from the root.
/emulator-server
emulator/coverage.txt
tui/gact
tui/coverage.txt

# VHS produced media (we whitelist screenshots/ which is committed)
**/*.gif
!docs/**/*.gif
*.webm
*.mp4

# Committed screenshots: curated .png baselines + the index only. Run dumps
# and raw captures under screenshots/ are CI artifacts, never tracked — the
# ignore rules enforce the media policy so a stray run can't re-bleed in.
!screenshots/
screenshots/**
!screenshots/**/
!screenshots/**/*.png
!screenshots/**/README.md
!screenshots/**/.gitkeep
# Belt-and-suspenders: run-dump artifact types stay ignored regardless.
screenshots/**/*.jsonl
screenshots/**/*.log
screenshots/**/*.json
screenshots/**/*.html
screenshots/**/*.txt
.clio_agent/

# Backup files
*.bak

# Regenerated CI screenshot dumps under apps/web/screenshots/ are ignored
# (audit/, 0.8.4-audit/, overnight-real-*, earthscope-*, ad-hoc .html/.json
# captures), but the named visual-regression baselines mandated by
# apps/CLAUDE.md's "Visual proof requirements" are tracked — a contributor
# following rule #4 must be able to commit a refreshed baseline.
apps/web/screenshots/**
!apps/web/screenshots/connect-screen.png
!apps/web/screenshots/empty-sidebar.png
!apps/web/screenshots/chat-streaming.png
!apps/web/screenshots/permission-card.png
!apps/web/screenshots/density-verbose.png
!apps/web/screenshots/density-summary.png
!apps/web/screenshots/starting-clio-splash.png
!apps/web/screenshots/chat-live-stream.png
!apps/web/screenshots/permission-allow-once.png
!apps/web/screenshots/permission-deny.png
!apps/web/screenshots/diff-pane-open.png
!apps/web/screenshots/diff-per-hunk-apply.png
!apps/web/screenshots/density-keybind-verbose.png
!apps/web/screenshots/density-keybind-summary.png
!apps/web/screenshots/slash-palette.png
!apps/web/screenshots/at-mention-picker.png
!apps/web/screenshots/stop-mid-stream.png
!apps/web/screenshots/settings-backends.png
!apps/web/screenshots/add-remote-ssh-wizard.png
!apps/web/screenshots/multi-backend-picker.png

# Python bytecode
__pycache__/
*.pyc

# Stray root-level images (screenshots/ and docs/ are the sanctioned homes;
# no root image is tracked — verified 2026-07)
/*.png
/*.gif
