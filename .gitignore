# Local research clones — read-only references, not part of the project
research/

# iowarp/clio-agent clone — exploration only, integration target for
# the TUI. Not part of this repo's distribution; kept out of tracking.
clio-agent/

# Go build artifacts
bin/
.tools/
*.test
*.out
*.prof
coverage.txt
coverage.html

# Loop-test artifacts (kept for reference but binaries/screenshots regenerated)
examples/loop-test/hello
examples/loop-test/hello.gif
examples/loop-test/screenshot.png
examples/loop-test/loop-test
# Note: examples/loop-test/testdata/ holds the committed teatest golden fixtures
# (required for `go test` to pass in CI) — do NOT ignore it.

# Claude Code session-only state
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/settings.local.json
.clio-agent-artifacts/
.playwright-mcp/
.mcp.json
tmp/
tui/gact.exe

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Env / secrets
.env
.env.*
*.pem
*.key

# Emulator / TUI build outputs (added once those exist)
emulator/emulator-server
# Stray binary that occasionally lands at the repo root from
# `go build -o emulator-server ./emulator/...` run from the root.
/emulator-server
emulator/coverage.txt
tui/gact
tui/coverage.txt

# VHS produced media (we whitelist screenshots/ which is committed)
**/*.gif
!docs/**/*.gif
*.webm
*.mp4

# Screenshots live ONLY in docs/screenshots/ (media policy in CLAUDE.md,
# enforced by scripts/check_media_policy.py — iowarp/gact-tui#235). The old
# scattered screenshots/ tree is deleted; ignore it so a stray run can't
# re-introduce committed captures outside the one sanctioned folder.
screenshots/
.clio_agent/

# Backup files
*.bak

# apps/web/ visual-test captures are regenerable output, never tracked. The
# Playwright suite renders them on demand (uploaded as a CI artifact); the sole
# committed screenshot home is docs/screenshots/ (media policy in CLAUDE.md,
# enforced by scripts/check_media_policy.py — iowarp/gact-tui#235). Ignore the
# whole tree; do not re-introduce tracked baselines here.
apps/web/screenshots/

# Python bytecode
__pycache__/
*.pyc

# Stray root-level images (screenshots/ and docs/ are the sanctioned homes;
# no root image is tracked — verified 2026-07)
/*.png
/*.gif
