{
  "name": "@clio/web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clio": "node scripts/with-brand.mjs clio dev",
    "dev:gact": "node scripts/with-brand.mjs gact dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:clio": "node scripts/with-brand.mjs clio build",
    "build:gact": "node scripts/with-brand.mjs gact build",
    "preview": "vite preview --port 4173",
    "demo:record": "node scripts/record-web-demo.mjs",
    "demo:earthscope-render": "node scripts/earthscope-render-demo.mjs",
    "probe:earthscope-sse": "node scripts/probe-earthscope-sse.mjs",
    "verify:deleted-filters": "node scripts/verify-deleted-filters.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@clio/core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tauri-apps/api": "2.1.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "highlight.js": "^11.11.1",
    "pdfjs-dist": "6.1.200",
    "solid-js": "1.9.12",
    "streaming-markdown": "^0.2.15"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@solidjs/testing-library": "0.8.10",
    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "@vitest/web-worker": "2.1.8",
    "eslint": "9.16.0",
    "eslint-plugin-solid": "0.14.5",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-solid": "2.11.0",
    "vitest": "2.1.8"
  }
}
