{
  "name": "@clio/apps",
  "version": "0.0.1",
  "private": true,
  "description": "CLIO web + desktop frontends for GACT v0.2",
  "scripts": {
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm --filter @clio/core build && pnpm --filter @clio/web build",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.10"
  }
}
