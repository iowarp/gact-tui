{
  "name": "@clio/desktop",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "echo 'no JS/TS lint for @clio/desktop (Rust crate via cargo)' && exit 0",
    "typecheck": "echo 'no TS to typecheck — @clio/desktop is a Rust crate; smoke tests are JS' && exit 0",
    "test": "node --test tests/smoke.test.mjs",
    "test:webview": "node --test tests/webview-e2e.test.mjs",
    "fetch-sidecar": "bash scripts/fetch-sidecar.sh",
    "fetch-sidecar:all": "bash scripts/fetch-sidecar.sh --all",
    "gen-brand-backend": "node scripts/gen-brand-backend.mjs",
    "build-clio-runtime": "node scripts/build-clio-runtime.mjs",
    "tauri": "tauri",
    "tauri:dev": "pnpm fetch-sidecar && tauri dev",
    "tauri:build": "pnpm fetch-sidecar && tauri build",
    "tauri:build:debug": "pnpm fetch-sidecar && tauri build --debug --no-bundle",
    "tauri:build:bundled": "pnpm fetch-sidecar && pnpm build-clio-runtime && tauri build --config src-tauri/tauri.bundled.conf.json"
  },
  "dependencies": {
    "@clio/web": "workspace:*",
    "@tauri-apps/api": "2.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.1.0",
    "typescript": "5.6.3"
  }
}
