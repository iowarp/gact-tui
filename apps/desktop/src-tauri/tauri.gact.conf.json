{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GACT Desktop",
  "identifier": "land.charm.gact.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @clio/web build:gact",
    "beforeDevCommand": "pnpm --filter @clio/web dev:gact"
  },
  "app": {
    "windows": [
      {
        "title": "GACT Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "shortDescription": "GACT Desktop — multi-backend agentic-coder UI",
    "longDescription": "GACT Desktop is the Tauri-shell wrapper for the GACT web frontend. It speaks the GACT contract, manages SSH-tunneled multi-backend access via the OS keychain, and ships native installers per platform.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iowarp/gact-tui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQ0FBOEYyMjFFMDQzQ0YKUldUUFErQWg4cWpLZ2o3SkxUSEU2QU1kd3F3dmdYU2llbHdnZVArSzhkbnJEb1RoZTZZd09UOXEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
