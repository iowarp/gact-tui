{
  "version": 1,
  "cases": [
    {
      "name": "trajectories-minimal",
      "preset": "trajectories",
      "fields": {
        "xField": "step",
        "yField": "loss",
        "entityField": "run"
      },
      "expected": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {
          "name": "source"
        },
        "description": "loss over step, one line per run.",
        "encoding": {
          "color": {
            "field": "run",
            "legend": null,
            "type": "nominal"
          },
          "detail": {
            "field": "run",
            "type": "nominal"
          },
          "opacity": {
            "condition": {
              "param": "sel",
              "value": 1
            },
            "value": 0.15
          },
          "strokeWidth": {
            "condition": {
              "param": "sel",
              "value": 3
            },
            "value": 1
          },
          "tooltip": [
            {
              "field": "run",
              "type": "nominal"
            },
            {
              "field": "step",
              "type": "quantitative"
            },
            {
              "field": "loss",
              "type": "quantitative"
            }
          ],
          "x": {
            "field": "step",
            "type": "quantitative"
          },
          "y": {
            "field": "loss",
            "type": "quantitative"
          }
        },
        "mark": {
          "point": true,
          "type": "line"
        },
        "params": [
          {
            "name": "sel",
            "select": {
              "clear": "dblclick",
              "fields": [
                "run"
              ],
              "on": "click",
              "type": "point"
            }
          }
        ]
      }
    },
    {
      "name": "trajectories-temporal-grouped-faceted",
      "preset": "trajectories",
      "fields": {
        "xField": "time",
        "yField": "disp_mm",
        "entityField": "station",
        "colorField": "network",
        "facetField": "component",
        "xType": "temporal"
      },
      "expected": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {
          "name": "source"
        },
        "description": "disp_mm over time, one line per station.",
        "encoding": {
          "color": {
            "field": "network",
            "type": "nominal"
          },
          "detail": {
            "field": "station",
            "type": "nominal"
          },
          "facet": {
            "columns": 3,
            "field": "component",
            "type": "nominal"
          },
          "opacity": {
            "condition": {
              "param": "sel",
              "value": 1
            },
            "value": 0.15
          },
          "strokeWidth": {
            "condition": {
              "param": "sel",
              "value": 3
            },
            "value": 1
          },
          "tooltip": [
            {
              "field": "station",
              "type": "nominal"
            },
            {
              "field": "network",
              "type": "nominal"
            },
            {
              "field": "time",
              "type": "temporal"
            },
            {
              "field": "disp_mm",
              "type": "quantitative"
            }
          ],
          "x": {
            "field": "time",
            "type": "temporal"
          },
          "y": {
            "field": "disp_mm",
            "type": "quantitative"
          }
        },
        "mark": {
          "point": true,
          "type": "line"
        },
        "params": [
          {
            "name": "sel",
            "select": {
              "clear": "dblclick",
              "fields": [
                "station"
              ],
              "on": "click",
              "type": "point"
            }
          }
        ]
      }
    },
    {
