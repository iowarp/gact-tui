          "color": {
            "field": "sample",
            "legend": null,
            "type": "nominal"
          },
          "detail": {
            "field": "sample",
            "type": "nominal"
          },
          "opacity": {
            "condition": {
              "param": "sel",
              "value": 1
            },
            "value": 0.15
          },
          "strokeWidth": {
            "condition": {
              "param": "sel",
              "value": 2.5
            },
            "value": 1
          },
          "tooltip": [
