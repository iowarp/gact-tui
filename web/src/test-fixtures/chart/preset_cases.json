        },
        "description": "permeability against porosity, one point per row.",
        "encoding": {
          "opacity": {
            "condition": {
              "param": "picked",
              "value": 1
            },
            "value": 0.15
          },
          "size": {
            "condition": {
              "param": "picked",
              "value": 90
            },
            "value": 30
          },
          "tooltip": [
            {
              "field": "core",
              "type": "nominal"
            },
            {
              "field": "porosity",
              "type": "quantitative"
            },
            {
              "field": "permeability",
              "type": "quantitative"
            }
          ],
          "x": {
            "field": "porosity",
            "type": "quantitative"
          },
          "y": {
            "field": "permeability",
            "type": "quantitative"
          }
        },
        "mark": {
          "filled": true,
          "type": "point"
        },
        "params": [
          {
            "name": "picked",
            "select": {
              "clear": "dblclick",
              "fields": [
                "core"
              ],
              "on": "click",
              "type": "point"
            }
          }
        ]
