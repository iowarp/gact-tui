        },
        "params": [
          {
            "name": "sel",
            "select": {
              "clear": "dblclick",
              "fields": [
                "sample"
              ],
              "on": "click",
              "type": "point"
            }
          }
        ]
      }
    },
    {
      "name": "heatmap-minimal",
      "preset": "heatmap",
      "fields": {
        "xField": "hour",
        "yField": "sensor",
        "colorField": "temp_c",
        "entityField": "sensor"
      },
      "expected": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {
          "name": "source"
        },
        "description": "temp_c by hour and sensor.",
        "encoding": {
          "color": {
            "field": "temp_c",
            "type": "quantitative"
          },
          "opacity": {
            "condition": {
              "param": "sel",
              "value": 1
            },
            "value": 0.3
          },
          "stroke": {
            "condition": {
              "empty": false,
              "param": "sel",
              "value": "black"
            },
            "value": null
          },
          "strokeWidth": {
            "condition": {
              "empty": false,
              "param": "sel",
              "value": 2
            },
            "value": 0
          },
          "tooltip": [
            {
              "field": "sensor",
              "type": "nominal"
            },
            {
              "field": "hour",
              "type": "ordinal"
            },
            {
              "field": "sensor",
              "type": "ordinal"
            },
            {
              "field": "temp_c",
              "type": "quantitative"
            }
          ],
          "x": {
            "field": "hour",
            "type": "ordinal"
          },
          "y": {
            "field": "sensor",
            "type": "ordinal"
          }
        },
        "mark": {
          "type": "rect"
        },
        "params": [
          {
            "name": "sel",
            "select": {
              "clear": "dblclick",
              "fields": [
                "sensor"
              ],
              "on": "click",
              "type": "point"
            }
          }
        ]
      }
    },
    {
      "name": "boxplot-grouped",
      "preset": "boxplot",
      "fields": {
        "xField": "treatment",
        "yField": "yield",
        "entityField": "plot",
        "colorField": "site"
      },
      "expected": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {
          "name": "source"
        },
        "description": "Distribution of yield by treatment, points per plot.",
        "layer": [
          {
            "encoding": {
              "color": {
                "field": "site",
                "type": "nominal"
              },
              "x": {
                "field": "treatment",
                "type": "nominal"
              },
              "y": {
                "field": "yield",
                "type": "quantitative"
              }
            },
            "mark": {
              "extent": 1.5,
              "outliers": false,
              "type": "boxplot"
            }
          },
          {
            "encoding": {
              "detail": {
                "field": "plot",
                "type": "nominal"
              },
              "opacity": {
                "condition": {
                  "param": "sel",
                  "value": 1
                },
                "value": 0.2
              },
              "size": {
                "condition": {
                  "param": "sel",
                  "value": 80
                },
                "value": 20
              },
              "tooltip": [
                {
                  "field": "plot",
                  "type": "nominal"
                },
                {
                  "field": "site",
                  "type": "nominal"
                },
                {
                  "field": "treatment",
                  "type": "nominal"
                },
                {
                  "field": "yield",
                  "type": "quantitative"
                }
              ],
              "x": {
                "field": "treatment",
                "type": "nominal"
              },
              "y": {
                "field": "yield",
                "type": "quantitative"
              }
            },
            "mark": {
              "filled": true,
              "type": "point"
            },
            "params": [
              {
                "name": "sel",
                "select": {
                  "clear": "dblclick",
                  "fields": [
                    "plot"
                  ],
                  "on": "click",
                  "type": "point"
                }
              }
            ]
          }
        ]
      }
    },
    {
