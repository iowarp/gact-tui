{
  "defaults": {
    "selectionParam": "sel",
    "xType": "quantitative"
  },
  "description": "One line (with points) per entity: yField over xField. Color by colorField (a group) when given, otherwise by entity; facet by facetField when given. Clicking a line selects that entity.",
  "optionalFields": [
    "colorField",
    "facetField",
    "xType",
    "selectionParam"
  ],
  "preset": "trajectories",
  "requiredFields": [
    "xField",
    "yField",
    "entityField"
  ],
  "template": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "source"
    },
    "description": "{{yField}} over {{xField}}, one line per {{entityField}}.",
    "encoding": {
      "color": {
        "$if": "colorField",
        "else": {
          "field": "{{entityField}}",
          "legend": null,
          "type": "nominal"
        },
        "then": {
          "field": "{{colorField}}",
          "type": "nominal"
        }
      },
      "detail": {
        "field": "{{entityField}}",
        "type": "nominal"
      },
      "facet": {
        "$if": "facetField",
        "then": {
          "columns": 3,
          "field": "{{facetField}}",
          "type": "nominal"
        }
      },
      "opacity": {
        "condition": {
          "param": "{{selectionParam}}",
          "value": 1
        },
        "value": 0.15
      },
      "strokeWidth": {
        "condition": {
          "param": "{{selectionParam}}",
          "value": 3
        },
        "value": 1
      },
      "tooltip": [
        {
          "field": "{{entityField}}",
          "type": "nominal"
        },
        {
          "$if": "colorField",
          "then": {
            "field": "{{colorField}}",
            "type": "nominal"
          }
        },
        {
          "field": "{{xField}}",
          "type": "{{xType}}"
        },
        {
          "field": "{{yField}}",
          "type": "quantitative"
        }
      ],
      "x": {
        "field": "{{xField}}",
        "type": "{{xType}}"
      },
      "y": {
        "field": "{{yField}}",
        "type": "quantitative"
      }
    },
    "mark": {
      "point": true,
      "type": "line"
    },
    "params": [
      {
        "name": "{{selectionParam}}",
        "select": {
          "clear": "dblclick",
          "fields": [
            "{{entityField}}"
          ],
          "on": "click",
          "type": "point"
        }
      }
    ]
  }
}
