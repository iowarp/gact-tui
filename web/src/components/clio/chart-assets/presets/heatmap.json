{
  "defaults": {
    "selectionParam": "sel",
    "xType": "ordinal"
  },
  "description": "A grid of cells: xField by yField, filled by the numeric colorField. Facet by facetField when given. Clicking a cell selects its entity; the selected entity's cells are outlined and the rest dimmed.",
  "optionalFields": [
    "facetField",
    "xType",
    "selectionParam"
  ],
  "preset": "heatmap",
  "requiredFields": [
    "xField",
    "yField",
    "colorField",
    "entityField"
  ],
  "template": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "name": "source"
    },
    "description": "{{colorField}} by {{xField}} and {{yField}}.",
    "encoding": {
      "color": {
        "field": "{{colorField}}",
        "type": "quantitative"
      },
      "facet": {
        "$if": "facetField",
        "then": {
          "columns": 3,
          "field": "{{facetField}}",
          "type": "nominal"
        }
      },
      "opacity": {
        "condition": {
          "param": "{{selectionParam}}",
          "value": 1
        },
        "value": 0.3
      },
      "stroke": {
        "condition": {
          "empty": false,
          "param": "{{selectionParam}}",
          "value": "black"
        },
        "value": null
      },
      "strokeWidth": {
        "condition": {
          "empty": false,
          "param": "{{selectionParam}}",
          "value": 2
        },
        "value": 0
      },
      "tooltip": [
        {
          "field": "{{entityField}}",
          "type": "nominal"
        },
        {
          "field": "{{xField}}",
          "type": "{{xType}}"
        },
        {
          "field": "{{yField}}",
          "type": "ordinal"
        },
        {
          "field": "{{colorField}}",
          "type": "quantitative"
        }
      ],
      "x": {
        "field": "{{xField}}",
        "type": "{{xType}}"
      },
      "y": {
        "field": "{{yField}}",
        "type": "ordinal"
      }
    },
    "mark": {
      "type": "rect"
    },
    "params": [
      {
        "name": "{{selectionParam}}",
        "select": {
          "clear": "dblclick",
          "fields": [
            "{{entityField}}"
          ],
          "on": "click",
          "type": "point"
        }
      }
    ]
  }
}
